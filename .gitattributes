# Normalise line endings so the same file doesn't show as "modified" on every
# checkout. core.autocrlf=true was rewriting LF -> CRLF in the working tree,
# which made 18 files look dirty in `git status` with zero real changes.
* text=auto eol=lf

# Files that must stay exactly as-is (generated or binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp4 binary

# Lockfiles and generated output
package-lock.json -diff
*.tsbuildinfo -diff