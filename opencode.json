{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://postgres:postgres@localhost:5432/nexus_commerce"]
    },
    "stripe": {
      "type": "local",
      "command": ["npx", "-y", "@stripe/mcp"],
      "environment": {
        "STRIPE_SECRET_KEY": ""
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    }
  }
}
