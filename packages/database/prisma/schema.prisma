generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  CUSTOMER
  RETAILER
  DEVELOPER
  SUPER_DEVELOPER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CustomerGroup {
  REGULAR
  VIP
  WHOLESALE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationType {
  ORDER_CONFIRMATION
  SHIPPING_UPDATE
  LOW_STOCK
  PRICE_DROP
  BACK_IN_STOCK
  ABANDONED_CART
  REVIEW_REMINDER
  ADMIN_ANNOUNCEMENT
  SECURITY_ALERT
  NEW_ORDER_ALERT
  TIER_WARNING
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?
  googleId       String?  @unique
  firstName      String
  lastName       String
  role           UserRole @default(CUSTOMER)
  isActive       Boolean  @default(true)
  emailVerified  Boolean  @default(false)
  twoFactorEnabled Boolean @default(false)
  avatar         String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer      Customer?
  retailer      Retailer?
  developer     Developer?
  sessions      Session[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  carts         Cart[]
  stores        Store[]

  @@map("users")
}

model MagicLinkToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@map("magic_link_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model Customer {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes         String       @default("")
  group         CustomerGroup @default(REGULAR)
  totalOrders   Int          @default(0)
  totalSpent    Float        @default(0)
  loyaltyPoints Int          @default(0)
  createdAt     DateTime     @default(now())

  addresses     Address[]
  reviews       Review[]
  wishlists     Wishlist[]
  orders        Order[]
  supportTickets SupportTicket[]
  couponUsage   CouponUsage[]

  @@map("customers")
}

model Retailer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName String
  storeSlug String   @unique
  createdAt DateTime @default(now())

  subscription RetailerSubscription?

  @@map("retailers")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model RetailerSubscription {
  id               String             @id @default(uuid())
  retailerId       String             @unique
  retailer         Retailer           @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  status           SubscriptionStatus @default(TRIAL)
  trialStart       DateTime           @default(now())
  trialEnd         DateTime
  lastBillingDate  DateTime?
  nextBillingDate  DateTime?
  weeklyAmount     Float              @default(3000)
  currency         String             @default("UGX")
  graceNotifiedAt  DateTime?
  suspendedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments         SubscriptionPayment[]

  @@map("retailer_subscriptions")
}

model SubscriptionPayment {
  id            String             @id @default(uuid())
  subscriptionId String
  subscription  RetailerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String             @default("UGX")
  method        String
  status        PaymentStatus      @default(PENDING)
  transactionId String?            @unique
  customerNote  String?
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime   @default(now())

  @@index([subscriptionId, createdAt])
  @@map("subscription_payments")
}

model Developer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("developers")
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  ipAddress   String
  userAgent   String
  isActive    Boolean  @default(true)
  lastActivity DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId, isActive])
  @@map("sessions")
}

model Store {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings StoreSettings?
  theme    StoreTheme?
  emails   StoreEmail[]

  products    Product[]
  categories  Category[]
  brands      Brand[]
  carts       Cart[]
  orders      Order[]
  reviews     Review[]
  media       Media[]
  coupons     Coupon[]
  wishlists   Wishlist[]

  @@map("stores")
}

model StoreSettings {
  id               String  @id @default(uuid())
  storeId          String  @unique
  store            Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  currency         String  @default("UGX")
  location         String  @default("Kampala, Uganda")
  shippingRate     Float   @default(0)
  shippingThreshold Float  @default(0)
  phone            String  @default("")
  whatsapp         String  @default("")

  @@map("store_settings")
}

model StoreTheme {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  template String @default("elegance")
  colors   Json   @default("{\"primary\":\"#D4A843\",\"secondary\":\"#A8822E\",\"bg\":\"#0A0A0A\",\"surface\":\"#141414\",\"text\":\"#FAFAFA\",\"accent\":\"#F0D48A\"}")

  @@map("store_themes")
}

model StoreEmail {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email   String
  label   String @default("")

  @@map("store_emails")
}

model Category {
  id          String     @id @default(uuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String     @default("")
  image       String     @default("")
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([storeId, slug])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  logo        String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, slug])
  @@map("brands")
}

model Product {
  id               String        @id @default(uuid())
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  brand            String        @default("")
  sku              String
  description      String        @default("")
  specifications   Json          @default("{}")
  features         String[]
  price            Float
  compareAtPrice   Float?
  costPerItem      Float?
  currency         String        @default("UGX")
  stock            Int           @default(0)
  lowStockThreshold Int          @default(10)
  trackInventory   Boolean       @default(true)
  allowBackorder   Boolean       @default(false)
  status           ProductStatus @default(DRAFT)
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags             String[]
  seoTitle         String        @default("")
  seoDescription   String        @default("")
  returnPolicy     String        @default("")
  warranty         String        @default("")
  weight           Float         @default(0)
  weightUnit       String        @default("kg")
  shippingClass    String        @default("standard")
  estimatedDays    String        @default("5-7 business days")
  freeShipping     Boolean       @default(false)
  images           String[]
  isFeatured       Boolean       @default(false)
  isNew            Boolean       @default(false)
  shortCode        String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  variants         ProductVariant[]
  downloads        ProductDownload[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sku       String   @unique
  price     Float
  stock     Int      @default(0)
  options   Json     @default("[]")
  image     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@map("product_variants")
}

model ProductDownload {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  fileSize  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_downloads")
}

model Media {
  id           String   @id @default(uuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String   @default("")
  alt          String   @default("")
  type         String   @default("image")
  mimeType     String   @default("image/jpeg")
  size         Int      @default(0)
  data         String?
  width        Int      @default(0)
  height       Int      @default(0)
  folder       String   @default("general")
  productId    String?
  createdAt    DateTime @default(now())

  @@index([storeId, createdAt])
  @@map("media")
}

model Address {
  id        String   @id @default(uuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  firstName String
  lastName  String
  company   String   @default("")
  line1     String
  line2     String   @default("")
  city      String
  state     String
  postalCode String
  country   String   @default("US")
  phone     String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("addresses")
}

model Order {
  id               String      @id @default(uuid())
  storeId          String
  store            Store       @relation(fields: [storeId], references: [id])
  orderNumber      String      @unique
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id])
  guestEmail       String      @default("")
  guestName        String      @default("")
  status           OrderStatus @default(PENDING)
  subtotal         Float
  shippingCost     Float       @default(0)
  taxAmount        Float       @default(0)
  discountAmount   Float       @default(0)
  couponId         String?
  total            Float
  currency         String      @default("UGX")
  customerPhone    String      @default("")
  shippingAddress  String      @default("")
  paymentMethod    String      @default("pay_on_delivery")
  paymentStatus    PaymentStatus @default(PENDING)
  notes            String      @default("")
  trackingNumber   String?
  estimatedDelivery DateTime?
  deliveredAt      DateTime?
  idempotencyKey   String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items     OrderItem[]
  payments  Payment[]

  @@index([storeId])
  @@index([customerId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  productName  String
  variantName  String?
  sku          String
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  image        String   @default("")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String        @default("USD")
  method        String
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  createdAt     DateTime      @default(now())

  @@map("payments")
}

model Coupon {
  id                 String       @id @default(uuid())
  storeId            String
  store              Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code               String
  description        String       @default("")
  discountType       DiscountType
  discountValue      Float
  minOrderAmount     Float        @default(0)
  maxUses            Int          @default(0)
  usedCount          Int          @default(0)
  maxUsesPerCustomer Int          @default(0)
  isActive           Boolean      @default(true)
  startsAt           DateTime
  expiresAt          DateTime
  appliesTo          String[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  usage CouponUsage[]

  @@unique([storeId, code])
  @@map("coupons")
}

model CouponUsage {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([couponId, customerId])
  @@map("coupon_usage")
}

model Review {
  id               String   @id @default(uuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  rating           Int
  title            String   @default("")
  content          String   @default("")
  images           String[]
  isVerifiedPurchase Boolean @default(false)
  isApproved       Boolean  @default(false)
  helpfulCount     Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([productId, createdAt])
  @@map("reviews")
}

model Wishlist {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String   @default("Default")
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model Cart {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  customerId  String?
  user        User?    @relation(fields: [customerId], references: [id])
  sessionId   String?
  couponCode  String?
  couponDiscount Float  @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  items CartItem[]

  @@index([storeId, customerId])
  @@index([storeId, sessionId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  quantity  Int     @default(1)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String
  data      Json               @default("{}")
  isRead    Boolean            @default(false)
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  resource  String
  resourceId String  @default("")
  details   Json     @default("{}")
  ipAddress String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model SupportTicket {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject     String
  description String
  status      String   @default("OPEN")
  priority    String   @default("NORMAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id         String       @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  message    String
  createdAt  DateTime     @default(now())

  @@map("ticket_messages")
}

model Setting {
  key        String   @id
  value      Json
  updatedAt  DateTime @updatedAt

  @@map("settings")
}

model FeatureFlag {
  key         String   @id
  name        String
  description String   @default("")
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model KillSwitch {
  id                 String   @id @default(uuid())
  storefront         Boolean  @default(false)
  retailerDashboard  Boolean  @default(false)
  customerRegistration Boolean @default(false)
  checkout           Boolean  @default(false)
  orders             Boolean  @default(false)
  uploads            Boolean  @default(false)
  payments           Boolean  @default(false)
  apis               Boolean  @default(false)
  search             Boolean  @default(false)
  maintenance        Boolean  @default(false)
  maintenanceMessage String   @default("We are currently undergoing scheduled maintenance. Please check back soon.")
  updatedAt          DateTime @updatedAt
  updatedBy          String   @default("system")

  @@map("kill_switch")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventType  String
  data       Json     @default("{}")
  pageUrl    String   @default("")
  sessionId  String   @default("")
  userId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([sessionId])
  @@index([userId])
  @@map("analytics_events")
}

model AdVideo {
  id         String   @id @default(uuid())
  sourceUrl  String
  templateId String
  format     String   @default("9:16")
  status     String   @default("QUEUED")
  videoUrl   String?
  script     Json?
  error      String?
  createdBy  String?
  data       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([templateId])
  @@map("ad_videos")
}