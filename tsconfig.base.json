{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@nexus/shared": ["packages/shared/src"],
      "@nexus/database": ["packages/database/src"],
      "@nexus/api": ["packages/api/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}